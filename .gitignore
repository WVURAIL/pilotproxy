__pycache__/
*.py[cod]
.venv/
*.egg-info/
.canfar_registry.env
*.npz
*.npy
*.mat
*.h5
*.pdf
*.png
# pytest cache
.pytest_cache/
# Deterministic TeX facts generated from profiles and source constants.
docs/generated/
docs/auxil/
docs/out/
# PilotProxy CUDA kernel build artifacts (make build-kernel / test-kernel)
cuda/*.o
cuda/*.so*
# the preserved kernel is machine-local, and its manifest stays with it
cuda/*.manifest.json
cuda/test_c_header
cuda/test_pilotproxy_cuda
cuda/test_pilotproxy_reference
cuda/.config_*.stamp

# Jupyter checkpoints
.ipynb_checkpoints/
build/
work/
generated/
results/

# Evidence studies are committed whole. A study directory under docs/evidence/
# is the record a dissertation chapter cites, so it must carry its own figures
# (*.png, *.pdf), arrays (*.npz, *.npy, *.h5) and any subdirectory named
# build/, work/, generated/ or results/. The rules above would ignore all of
# these without a warning. Git cannot re-include a file under an excluded
# directory, so the directory itself is re-included first. This block comes
# last so that it is the final matching pattern for both.
!docs/evidence/**/
!docs/evidence/**

# These rules keep caches, build leftovers and OS metadata ignored in the
# evidence tree. The re-inclusion above ignores file extensions, so without them
# it would also track such files when they are written under an evidence
# directory.
docs/evidence/**/__pycache__/
docs/evidence/**/*.py[cod]
docs/evidence/**/.pytest_cache/
docs/evidence/**/.DS_Store
docs/evidence/**/Thumbs.db
